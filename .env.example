# Server
PORT=3001
NODE_ENV=production

# Database (Docker: /data/finance.sqlite — local dev: ./data/finance.sqlite)
DB_PATH=/data/finance.sqlite

# Upload/data directory (Docker: /data — local dev: ./data)
DATA_PATH=/data

# E*TRADE API
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_BASE_URL=https://api.etrade.com

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# FX rate source (optional — for ILS/USD conversion)
FX_API_KEY=

# Reminders
# Option A: Email
REMINDER_EMAIL_FROM=
REMINDER_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option B: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
